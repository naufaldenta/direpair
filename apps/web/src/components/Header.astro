---
import type { SiteSettings } from '../lib/cms-types';
interface Props { settings: SiteSettings; }
const { settings } = Astro.props;
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="logo" href="/" aria-label="Direpair beranda">DIREPAIR</a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav"><span>Menu</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
    <nav id="site-nav" aria-label="Navigasi utama">
      <a href="/layanan/">Layanan</a><a href="/harga/">Harga</a><a href="/tentang/">Cara kerja</a><a href="/masalah/">Panduan</a>
      <a class="status-link" href={settings.status_path || '/cek-status/'}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 17h5l3-8 6 15 4-9 3 5h5" /></svg><span>Cek status</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></a>
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.toggleAttribute('data-open', !open);
  });
</script>
<style>
  .site-header{position:sticky;top:0;z-index:40;padding:18px 0 0;background:var(--paper)}
  .nav-wrap{display:flex;align-items:stretch;justify-content:space-between;min-height:72px;border:2px solid var(--route-navy);border-radius:12px;background:rgba(248,241,226,.96)}
  .logo{display:flex;align-items:center;padding:0 28px;border-right:1px solid rgba(1,29,56,.34);font-family:var(--font-display);font-size:1.65rem;font-weight:850;letter-spacing:-.035em}
  nav{display:flex;align-items:stretch;margin-left:auto;font-size:.78rem;font-weight:780;text-transform:uppercase}nav>a{display:flex;align-items:center;padding:0 24px;border-left:1px solid rgba(1,29,56,.22)}nav>a:hover{background:var(--route-navy);color:var(--paper);text-decoration:none}
  .status-link{gap:10px;min-width:184px}.status-link svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.status-link svg:last-child{margin-left:auto;width:19px}
  .menu-button{display:none;align-items:center;gap:9px;margin:8px;border:0;border-radius:7px;background:var(--route-navy);color:var(--paper);padding:10px 13px;font-weight:800}.menu-button svg{width:22px;fill:none;stroke:currentColor;stroke-width:2}
  @media(max-width:1120px){nav>a{padding-inline:15px}.logo{padding-inline:20px}}
  @media(max-width:900px){.site-header{padding-top:10px}.nav-wrap{position:relative;min-height:62px}.logo{border-right:0;font-size:1.35rem}.menu-button{display:flex;margin-left:auto}nav{display:none;position:absolute;left:-2px;right:-2px;top:68px;z-index:5;align-items:stretch;flex-direction:column;background:var(--paper);border:2px solid var(--route-navy);border-radius:10px;box-shadow:var(--shadow)}nav[data-open]{display:flex}nav>a{min-height:52px;border-left:0;border-bottom:1px solid rgba(1,29,56,.2)}nav>a:last-child{border-bottom:0}.status-link{min-width:0}}
</style>
