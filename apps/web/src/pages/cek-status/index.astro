---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Cek Status Repair | Direpair" description="Buka timeline privat repair Direpair menggunakan token yang diberikan setelah booking." noindex>
  <section class="status-page"><div class="container status-shell"><div class="status-route" aria-hidden="true"><span class="origin"></span><span class="line"></span><span class="station"></span></div><div class="status-card"><span class="route-code">PRIVATE ROUTE / TRACK-01</span><h1>Punya tautan status?</h1><p class="lede">Tempel token yang diterima setelah booking. Token berbeda dari nomor request dan berfungsi sebagai kunci privat.</p><form id="token-form"><div class="field"><label for="token">Token status</label><input id="token" name="token" minlength="32" autocomplete="off" spellcheck="false" required /></div><button class="button" type="submit">Buka status</button></form><p class="small muted">Jangan bagikan token di ruang publik. Direpair tidak meminta password akun untuk membuka halaman ini.</p></div></div></section>
</BaseLayout>
<script>const form=document.querySelector<HTMLFormElement>('#token-form');const input=document.querySelector<HTMLInputElement>('#token');const saved=sessionStorage.getItem('direpair_status_token');if(input&&saved)input.value=saved;form?.addEventListener('submit',(event)=>{event.preventDefault();const token=input?.value.trim();if(token&&token.length>=32)location.href=`/cek-status/${encodeURIComponent(token)}/`;});</script>
<style>.status-page{min-height:72vh;padding:88px 0 110px;background:color-mix(in srgb,var(--paper-deep) 68%,transparent)}.status-shell{display:grid;grid-template-columns:minmax(120px,.34fr) minmax(0,1fr);align-items:center}.status-route{display:flex;align-items:center}.status-route .origin,.status-route .station{width:22px;height:22px;border:5px solid var(--paper-deep);border-radius:50%;background:var(--route-red);box-shadow:0 0 0 3px var(--route-red)}.status-route .line{height:6px;flex:1;background:var(--route-red)}.status-route .station{width:42px;height:42px;background:var(--paper);border:8px solid var(--paper-deep);box-shadow:0 0 0 4px var(--ink)}.status-card{position:relative;padding:clamp(28px,5vw,58px);border:2px solid var(--ink);background:var(--paper);box-shadow:0 18px 42px rgba(1,29,56,.14)}.route-code{font-family:var(--font-mono);font-size:.7rem;font-weight:760;letter-spacing:.13em;color:var(--route-red)}.status-card h1{margin:22px 0 0;font-size:clamp(3rem,7vw,5.8rem);line-height:.88;letter-spacing:-.04em}.status-card .lede{margin:24px 0 30px}.status-card form{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end}.status-card>.small{margin:18px 0 0;padding-top:14px;border-top:1px dashed var(--line)}@media(max-width:700px){.status-shell{grid-template-columns:1fr}.status-route{width:42%;margin-bottom:24px}.status-card form{grid-template-columns:1fr}}@media(max-width:480px){.status-page{padding-top:58px}.status-card{padding:28px 18px;box-shadow:0 12px 28px rgba(1,29,56,.12)}.status-card h1{font-size:3.25rem}}</style>
