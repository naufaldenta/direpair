---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8000/api/v1';
const allowMockCheckout = import.meta.env.DEV;
---
<BaseLayout title="Status Repair Privat | Direpair" description="Timeline privat status repair, quotation, dan pembayaran Direpair." noindex>
  <section class="status-hero" data-api={apiBase} data-allow-mock={String(allowMockCheckout)}>
    <div class="container">
      <span class="route-code">PRIVATE ROUTE / LIVE STATUS</span>
      <div class="status-title">
        <div><h1 id="status-title">Memuat status…</h1><p id="status-message">Menghubungkan tautan privat ke backend repair.</p></div>
        <span id="status-badge" hidden></span>
      </div>
      <a id="status-retry" class="button" href="/cek-status/" hidden>Masukkan token lain</a>
    </div>
  </section>

  <div id="status-detail" hidden>
    <section class="section status-content">
      <div class="container status-grid">
        <div>
          <div class="section-heading"><div><span class="route-code">TIMELINE / ROUTE-LOG</span><h2>Perjalanan unitmu.</h2></div></div>
          <div id="timeline" class="timeline"></div>
        </div>
        <aside><div class="summary"><span class="route-code">REQUEST / SUMMARY</span><dl id="summary"></dl></div></aside>
      </div>
    </section>

    <section id="quote-section" class="section quote-section" hidden>
      <div class="container quote-grid">
        <div>
          <span id="quote-code" class="route-code"></span><h2>Diagnosis dan estimasi.</h2>
          <div class="diagnosis"><span id="repairability"></span><p id="diagnosis-summary"></p><strong id="estimated-days" hidden></strong></div>
          <p id="customer-notes" class="muted" hidden></p>
        </div>
        <div class="invoice">
          <table><tbody id="quote-items"></tbody><tfoot id="quote-totals"></tfoot></table>
          <form id="decision-form" hidden>
            <label class="terms"><input type="checkbox" name="terms" required /> Saya sudah membaca diagnosis, item biaya, masa berlaku, dan catatan quotation.</label>
            <div class="button-row"><button class="button" type="submit" data-decision="approve">Setujui quotation</button><button class="button secondary" type="submit" data-decision="reject">Tolak</button></div>
            <div class="form-status" role="status"></div>
          </form>
          <div id="approved" class="approved" hidden><strong>Quotation disetujui.</strong><p></p><a class="button" rel="noreferrer" referrerpolicy="no-referrer" hidden>Lanjut ke pembayaran</a></div>
        </div>
      </div>
    </section>
    <section class="section-sm"><div class="narrow security"><strong>Simpan tautan ini secara privat.</strong><p>Halaman tidak menampilkan nama, nomor telepon, alamat, keluhan lengkap, catatan internal, atau file lampiran.</p></div></section>
  </div>
</BaseLayout>

<script>
  const hero = document.querySelector<HTMLElement>('.status-hero');
  const apiBase = hero?.dataset.api?.replace(/\/$/, '') ?? '';
  const allowMockCheckout = hero?.dataset.allowMock === 'true';
  const queryToken = new URLSearchParams(location.search).get('token')?.trim() ?? '';
  const pathParts = location.pathname.split('/').filter(Boolean);
  const statusIndex = pathParts.indexOf('cek-status');
  const pathToken = statusIndex >= 0 ? pathParts[statusIndex + 1] ?? '' : '';
  const token = queryToken || pathToken;
  const title = document.querySelector<HTMLElement>('#status-title');
  const message = document.querySelector<HTMLElement>('#status-message');
  const badge = document.querySelector<HTMLElement>('#status-badge');
  const retry = document.querySelector<HTMLElement>('#status-retry');
  const detail = document.querySelector<HTMLElement>('#status-detail');
  const quoteSection = document.querySelector<HTMLElement>('#quote-section');
  const decisionForm = document.querySelector<HTMLFormElement>('#decision-form');
  let decisionUrl = '';

  const rupiah = (value: number) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(value);
  const date = (value: string, withTime = false) => new Intl.DateTimeFormat('id-ID', withTime ? { dateStyle: 'medium', timeStyle: 'short' } : { dateStyle: 'medium' }).format(new Date(value));
  const setText = (selector: string, value: unknown) => { const node = document.querySelector<HTMLElement>(selector); if (node) node.textContent = String(value ?? ''); };
  const create = (tag: string, value?: unknown) => { const node = document.createElement(tag); if (value !== undefined) node.textContent = String(value); return node; };
  const showError = (error: unknown) => {
    if (title) title.textContent = 'Status belum dapat dibuka.';
    if (message) message.textContent = error instanceof Error ? error.message : 'Token status tidak valid atau backend belum tersedia.';
    if (retry) retry.hidden = false;
  };
  const addSummary = (label: string, value: string) => {
    const row = document.createElement('div');
    row.append(create('dt', label), create('dd', value));
    document.querySelector('#summary')?.append(row);
  };

  const renderQuote = (quote: any) => {
    if (!quote || !quoteSection) return;
    quoteSection.hidden = false;
    setText('#quote-code', 'QUOTATION / REV-' + quote.version);
    setText('#repairability', String(quote.diagnosis?.repairability ?? '').replaceAll('_', ' '));
    setText('#diagnosis-summary', quote.diagnosis?.summary ?? '');
    const estimated = document.querySelector<HTMLElement>('#estimated-days');
    if (estimated && quote.diagnosis?.estimated_days) { estimated.textContent = 'Estimasi ' + quote.diagnosis.estimated_days + ' hari kerja'; estimated.hidden = false; }
    const notes = document.querySelector<HTMLElement>('#customer-notes');
    if (notes && quote.customer_notes) { notes.textContent = quote.customer_notes; notes.hidden = false; }

    const items = document.querySelector('#quote-items');
    for (const item of quote.items ?? []) {
      const row = document.createElement('tr');
      const description = document.createElement('td');
      description.append(create('strong', item.label));
      if (item.description) description.append(create('small', item.description));
      description.append(create('small', String(item.quantity) + ' × ' + rupiah(item.unit_price)));
      row.append(description, create('td', rupiah(item.total)));
      items?.append(row);
    }
    const totals = document.querySelector('#quote-totals');
    const totalRow = document.createElement('tr');
    totalRow.append(create('th', 'Total'), create('th', rupiah(quote.total)));
    totals?.append(totalRow);
    if (quote.deposit_required) {
      const depositRow = document.createElement('tr');
      depositRow.append(create('td', 'Deposit awal'), create('td', rupiah(quote.deposit_amount)));
      totals?.append(depositRow);
    }

    decisionUrl = apiBase + '/status/' + encodeURIComponent(token) + '/quotations/' + encodeURIComponent(quote.id) + '/decision';
    if (decisionForm) decisionForm.hidden = quote.status !== 'sent';
    const approved = document.querySelector<HTMLElement>('#approved');
    if (approved && quote.status === 'approved') {
      approved.hidden = false;
      const paid = quote.invoice && (quote.invoice.status === 'paid' || quote.invoice.payment_status === 'paid');
      const copy = approved.querySelector('p');
      const link = approved.querySelector<HTMLAnchorElement>('a');
      if (copy) copy.textContent = paid
        ? (quote.invoice.kind === 'deposit' ? 'Deposit sudah terverifikasi. Repair sedang diproses sesuai antrean.' : 'Pembayaran sudah terverifikasi. Unit siap mengikuti proses serah terima.')
        : quote.invoice?.checkout_url
          ? (quote.invoice.kind === 'deposit' ? 'Bayar deposit agar repair dapat dimulai.' : 'Selesaikan pembayaran sebelum serah terima.')
          : 'Tim akan melanjutkan pekerjaan sesuai alur di atas.';
      if (link && !paid && quote.invoice?.checkout_url) {
        const checkout = new URL(quote.invoice.checkout_url);
        const isMockCheckout = checkout.pathname === '/mock-payment' || checkout.pathname === '/mock-payment/';
        if (isMockCheckout && !allowMockCheckout) {
          if (copy) copy.textContent = 'Pembayaran online belum diaktifkan. Tim Direpair akan menghubungi kamu mengenai langkah pembayaran berikutnya.';
        } else if (checkout.protocol === 'https:' || (allowMockCheckout && checkout.protocol === 'http:')) {
          link.href = checkout.toString();
          link.hidden = false;
        }
      }
    }
  };

  const renderStatus = (statusData: any) => {
    document.title = statusData.request_number + ' · Status Repair Direpair';
    if (title) title.textContent = statusData.request_number;
    if (message) message.textContent = [statusData.device?.brand, statusData.device?.model, statusData.device?.category].filter(Boolean).join(' · ');
    if (badge) { badge.textContent = statusData.status_label; badge.hidden = false; }
    if (detail) detail.hidden = false;
    const timeline = document.querySelector('#timeline');
    for (const [index, event] of (statusData.timeline ?? []).entries()) {
      const article = document.createElement('article');
      if (index === statusData.timeline.length - 1) article.className = 'current';
      const body = document.createElement('div');
      const time = create('time', date(event.occurred_at, true));
      time.setAttribute('datetime', event.occurred_at);
      body.append(time, create('h3', event.label));
      if (event.message) body.append(create('p', event.message));
      article.append(document.createElement('span'), body);
      timeline?.append(article);
    }
    addSummary('Status', statusData.status_label);
    addSummary('Metode', statusData.service_method);
    addSummary('Pembayaran', String(statusData.payment_status).replaceAll('_', ' '));
    addSummary('Masuk', date(statusData.submitted_at));
    renderQuote(statusData.quotation);
  };

  decisionForm?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-decision]');
    if (!button) return;
    event.preventDefault();
    const terms = decisionForm.querySelector<HTMLInputElement>('input[name="terms"]');
    const decision = button.dataset.decision;
    if (decision === 'approve' && !terms?.checked) { terms?.reportValidity(); return; }
    const status = decisionForm.querySelector<HTMLElement>('.form-status');
    decisionForm.querySelectorAll<HTMLButtonElement>('button').forEach((item) => { item.disabled = true; });
    if (status) { status.style.display = 'block'; status.textContent = 'Menyimpan keputusan…'; }
    try {
      const response = await fetch(decisionUrl, { method: 'POST', headers: { Accept: 'application/json', 'Content-Type': 'application/json' }, body: JSON.stringify({ action: decision, terms_accepted: decision === 'approve', website: '' }) });
      const payload = await response.json();
      if (!response.ok) {
        const errors = payload.errors ? Object.values(payload.errors).flat().join(' ') : payload.message;
        throw new Error(errors || 'Keputusan belum tersimpan.');
      }
      location.reload();
    } catch (error) {
      if (status) { status.dataset.state = 'error'; status.textContent = error instanceof Error ? error.message : 'Keputusan belum tersimpan.'; }
      decisionForm.querySelectorAll<HTMLButtonElement>('button').forEach((item) => { item.disabled = false; });
    }
  });

  if (!token || token === 'status') {
    showError(new Error('Token tidak ditemukan pada tautan ini.'));
  } else {
    sessionStorage.setItem('direpair_status_token', token);
    fetch(apiBase + '/status/' + encodeURIComponent(token), { headers: { Accept: 'application/json' } })
      .then(async (response) => {
        if (!response.ok) throw new Error(response.status === 404 ? 'Token status tidak ditemukan.' : 'Backend status sedang tidak tersedia.');
        return response.json();
      })
      .then((payload) => renderStatus(payload.data))
      .catch(showError);
  }
</script>

<style>
  .route-code{display:inline-block;font-family:var(--font-mono);font-size:.68rem;font-weight:760;letter-spacing:.13em;color:var(--route-red)}.status-hero{padding:65px 0;border-bottom:2px solid var(--ticket-yellow);background:var(--route-navy);color:var(--paper)}.status-hero .route-code{color:var(--ticket-yellow)}.status-hero h1{margin:18px 0 0;color:var(--paper)}.status-title{display:flex;align-items:end;justify-content:space-between;gap:30px}.status-title p{margin:10px 0 0;color:#b8c8d2}.status-title>span{display:inline-flex;padding:9px 14px;border:1px solid var(--ticket-yellow);color:var(--ticket-yellow);font-family:var(--font-mono);font-size:.72rem;font-weight:800;text-transform:uppercase}.status-content{background:color-mix(in srgb,var(--paper-deep) 68%,transparent)}.status-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:65px}.section-heading h2{margin-top:14px}.timeline{position:relative}.timeline::before{content:'';position:absolute;left:10px;top:10px;bottom:20px;width:5px;background:var(--route-green)}.timeline article{position:relative;display:grid;grid-template-columns:22px 1fr;gap:20px;padding-bottom:32px}.timeline article>span{position:relative;z-index:2;width:22px;height:22px;border:6px solid var(--paper-deep);border-radius:50%;background:var(--route-green);box-shadow:0 0 0 3px var(--route-green)}.timeline article.current>span{background:var(--route-red);box-shadow:0 0 0 3px var(--route-red)}.timeline time{color:var(--muted);font-family:var(--font-mono);font-size:.7rem;font-weight:750}.timeline h3{margin:3px 0 7px}.timeline p{margin:0;color:var(--muted)}.summary{position:sticky;top:110px;padding:28px;border:2px solid var(--ink);background:var(--paper);box-shadow:0 18px 42px rgba(1,29,56,.14)}.summary dl{margin:18px 0 0}.summary dl div{display:grid;grid-template-columns:90px 1fr;gap:12px;padding:14px 0;border-top:1px solid var(--ink)}.summary dt{color:var(--muted);font-family:var(--font-mono);font-size:.65rem;font-weight:800;text-transform:uppercase}.summary dd{margin:0;font-weight:750;text-transform:capitalize}.quote-section{border-top:2px solid var(--ink);background:var(--paper)}.quote-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:65px;align-items:start}.quote-grid h2{margin-top:14px}.diagnosis{margin:25px 0;padding:22px;border-top:2px solid var(--route-red);background:var(--paper-deep)}.diagnosis>span{display:inline-flex;padding:5px 9px;border:1px solid var(--route-green);color:var(--route-green);font-family:var(--font-mono);font-size:.66rem;font-weight:850;text-transform:uppercase}.diagnosis p{margin:13px 0}.invoice{padding:28px;border:2px solid var(--ink);background:var(--ticket-yellow);box-shadow:0 18px 42px rgba(1,29,56,.14)}.invoice table{width:100%;border-collapse:collapse}.invoice td,.invoice th{padding:13px 0;border-bottom:1px solid var(--ink);text-align:left;vertical-align:top}.invoice td:last-child,.invoice th:last-child{text-align:right;white-space:nowrap}.invoice small{display:block;color:var(--ink-soft);font-weight:400}.invoice tfoot th{font-size:1.2rem}.terms{display:flex;align-items:flex-start;gap:9px;margin:22px 0;font-size:.83rem}.terms input{margin-top:5px}.approved{padding:20px;margin-top:20px;border:1px solid var(--route-green);background:#d7eadf}.approved p{margin:5px 0 14px}.security{padding:22px;border-top:2px solid var(--route-green)}.security p{margin:5px 0 0;color:var(--muted)}@media(max-width:820px){.status-grid,.quote-grid{grid-template-columns:1fr}.status-title{align-items:flex-start;flex-direction:column}.summary{position:static}}@media(max-width:520px){.status-hero{padding:48px 0}.summary,.invoice{padding:20px;box-shadow:0 12px 28px rgba(1,29,56,.12)}.summary dl div{grid-template-columns:1fr;gap:3px}.button-row{display:grid}.button-row .button{width:100%}}
</style>
