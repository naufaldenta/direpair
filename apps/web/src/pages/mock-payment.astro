---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8000/api/v1';
---
<BaseLayout title="Mock Payment · Direpair Local" description="Simulator pembayaran khusus pengembangan lokal Direpair." noindex>
  <section class="mock-page"><div class="narrow"><div class="card mock-card"><span class="route-code">LOCAL / PAYMENT MOCK</span><h1>Simulasi pembayaran.</h1><p>Halaman ini hanya mengirim notifikasi <code>mock-paid</code>. Backend otomatis menolaknya di environment production.</p><dl><div><dt>Order ID</dt><dd id="order">—</dd></div><div><dt>Nominal</dt><dd id="amount">—</dd></div></dl><button class="button" id="pay" data-api={`${apiBase}/payments/midtrans/webhook`}>Simulasikan paid</button><div class="form-status" role="status"></div></div></div></section>
</BaseLayout>
<script>const query=new URLSearchParams(location.search);const order=query.get('order_id')??'';const amount=query.get('amount')??'';const orderEl=document.querySelector('#order');const amountEl=document.querySelector('#amount');if(orderEl)orderEl.textContent=order;if(amountEl)amountEl.textContent=amount?new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(Number(amount)):'—';document.querySelector<HTMLButtonElement>('#pay')?.addEventListener('click',async(event)=>{const button=event.currentTarget as HTMLButtonElement;const status=document.querySelector<HTMLElement>('.form-status');button.disabled=true;try{const response=await fetch(button.dataset.api??'',{method:'POST',headers:{Accept:'application/json','Content-Type':'application/json'},body:JSON.stringify({order_id:order,status_code:'200',gross_amount:`${amount}.00`,transaction_status:'mock-paid',transaction_id:`mock-${Date.now()}`})});const payload=await response.json();if(!response.ok)throw new Error(payload.message??'Simulasi ditolak.');if(status){status.dataset.state='success';status.textContent='Payment ditandai paid. Kembali ke halaman status untuk melihat perubahan.';}}catch(error){if(status){status.dataset.state='error';status.textContent=error instanceof Error?error.message:'Simulasi gagal.';}button.disabled=false;}});</script>
<style>.mock-page{min-height:70vh;padding:90px 0;background:var(--warm)}.mock-card{padding:clamp(25px,6vw,55px)}.mock-card h1{font-size:clamp(2.4rem,6vw,4.5rem)}.mock-card code{padding:2px 5px;border-radius:4px;background:#e8ecea}.mock-card dl{margin:28px 0}.mock-card dl div{display:grid;grid-template-columns:120px 1fr;padding:12px 0;border-top:1px solid var(--line)}.mock-card dt{color:var(--muted);font-size:.72rem;text-transform:uppercase}.mock-card dd{margin:0;font-weight:800}</style>
