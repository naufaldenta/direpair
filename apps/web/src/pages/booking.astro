---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCmsDataset, isTrustedPublicContent } from '../lib/cms';
const { services, settings, policies } = await getCmsDataset();
const bookingEnabled = !import.meta.env.PROD || policies.some((policy)=>policy.slug==='privacy' && isTrustedPublicContent(policy));
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8000/api/v1';
---
<BaseLayout title="Booking Diagnosis | Direpair" description="Ceritakan perangkat dan gejalanya untuk memulai proses diagnosis Direpair tanpa pembayaran penuh saat booking.">
  <section class="booking-hero"><div class="container booking-intro"><span class="route-chip">ENTRY / DIAGNOSIS</span><h1>Ceritakan apa yang terjadi.</h1><p class="lede">Satu tiket untuk mencatat perangkat, memilih metode layanan, dan menghubungkanmu dengan tim diagnosis.</p></div></section>
  <section class="section form-section"><div class="container booking-grid"><aside><span class="aside-code">PRE-FLIGHT / 03</span><h2>Sebelum mulai</h2><ol><li><span>01</span>Siapkan brand, model, dan gejala yang terlihat.</li><li><span>02</span>Foto opsional membantu pemeriksaan awal, tetapi bukan diagnosis final.</li><li><span>03</span>Tidak ada pembayaran penuh saat form ini dikirim.</li></ol><div class="privacy-note"><strong>Data repair tetap privat.</strong><p>Kontak, alamat, foto, quotation, dan payment disimpan di backend repair—bukan CMS publik.</p></div></aside>
    <div class="form-panel">{!bookingEnabled&&<div class="launch-block" role="alert"><strong>Booking production belum diaktifkan.</strong><p>Publikasikan kebijakan privasi yang telah diverifikasi di WordPress sebelum data pelanggan dikumpulkan.</p></div>}<div class="step-indicator" aria-label="Tahap form"><span data-dot="1"><b>01</b>Perangkat</span><span data-dot="2"><b>02</b>Layanan</span><span data-dot="3"><b>03</b>Kontak</span></div>
      <form id="booking-form" data-api={`${apiBase}/service-requests`} data-enabled={String(bookingEnabled)} enctype="multipart/form-data">
        <fieldset data-step="1"><legend>Perangkat dan keluhan</legend><div class="form-grid">
          <div class="field"><label for="service_slug">Kategori layanan</label><select id="service_slug" name="service_slug" required><option value="">Pilih layanan</option>{services.map((service) => <option value={service.slug}>{service.title}</option>)}</select></div>
          <div class="field"><label for="device_category">Jenis perangkat</label><input id="device_category" name="device_category" maxlength="120" placeholder="Contoh: TWS, robot vacuum" required /></div>
          <div class="field"><label for="brand">Brand</label><input id="brand" name="brand" maxlength="120" autocomplete="organization" /></div><div class="field"><label for="model">Model</label><input id="model" name="model" maxlength="120" /></div>
          <div class="field full"><label for="symptom">Apa gejalanya?</label><textarea id="symptom" name="symptom" minlength="10" maxlength="2000" placeholder="Sejak kapan, apa yang terjadi, lampu/indikator, dan langkah yang sudah dicoba…" required></textarea></div>
          <div class="field full"><label for="attachments">Foto atau PDF (opsional, maks. 5 file × 5 MB)</label><input id="attachments" name="attachments[]" type="file" multiple accept="image/jpeg,image/png,image/webp,application/pdf" /></div>
        </div><div class="nav-actions"><button class="button" type="button" data-next>Berikutnya</button></div></fieldset>
        <fieldset data-step="2" hidden><legend>Metode layanan</legend><div class="method-grid">
          <label><input type="radio" name="preferred_service_method" value="drop-off" checked /><strong>Drop-off</strong><span>Bawa unit setelah jadwal dan lokasi dikonfirmasi.</span></label>
          <label><input type="radio" name="preferred_service_method" value="pickup" /><strong>Pickup</strong><span>Tim mengonfirmasi area, jadwal, dan biaya penjemputan.</span></label>
          <label><input type="radio" name="preferred_service_method" value="home-service" /><strong>Home service</strong><span>Ketersediaan bergantung pada perangkat, gejala, dan area.</span></label>
        </div><div id="address-fields" class="form-grid address-fields" hidden><div class="field full"><label for="street">Alamat</label><input id="street" name="service_address[street]" maxlength="255" /></div><div class="field"><label for="city">Kota</label><input id="city" name="service_address[city]" maxlength="120" /></div><div class="field"><label for="postal">Kode pos</label><input id="postal" name="service_address[postal_code]" maxlength="12" /></div></div>
          <div class="field"><label for="urgency">Prioritas</label><select id="urgency" name="urgency"><option value="normal">Normal</option><option value="urgent">Mendesak — mohon konfirmasi kemungkinan jadwal</option></select></div><div class="nav-actions"><button class="button secondary" type="button" data-prev>Kembali</button><button class="button" type="button" data-next>Berikutnya</button></div></fieldset>
        <fieldset data-step="3" hidden><legend>Kontak dan persetujuan</legend><div class="form-grid"><div class="field"><label for="name">Nama</label><input id="name" name="name" autocomplete="name" minlength="2" maxlength="120" required /></div><div class="field"><label for="phone">Nomor HP</label><input id="phone" name="phone" autocomplete="tel" inputmode="tel" required /></div><div class="field full"><label for="email">Email (opsional)</label><input id="email" name="email" type="email" autocomplete="email" /></div></div>
          <div class="checks"><label><input type="checkbox" name="whatsapp_consent" value="1" /> Saya bersedia dihubungi melalui WhatsApp untuk request ini.</label><label><input type="checkbox" name="privacy_consent" value="1" required /> <span>Saya menyetujui data ini dipakai untuk memproses booking dan layanan repair sesuai <a href="/privacy/" target="_blank">kebijakan privasi</a>.</span></label></div><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="nav-actions"><button class="button secondary" type="button" data-prev>Kembali</button><button class="button" type="submit">Kirim booking</button></div></fieldset>
      </form><div id="form-status" class="form-status" role="status" aria-live="polite"></div>
    </div>
  </div></section>
  <section class="section-sm"><div class="narrow fine-print"><strong>Setelah dikirim</strong><p>Kamu menerima nomor request dan tautan status privat. Simpan tautan tersebut—token tidak ditampilkan ulang oleh sistem. Harga final baru tersedia setelah diagnosis.</p>{settings.whatsapp && <p>Butuh bantuan? WhatsApp <a href={`https://wa.me/${settings.whatsapp.replace(/\D/g,'')}`}>{settings.whatsapp}</a> dengan menyertakan nomor request.</p>}</div></section>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#booking-form');
  if (form?.dataset.enabled === 'false') form.querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement|HTMLButtonElement>('input,select,textarea,button').forEach((control)=>control.disabled=true);
  const steps = Array.from(document.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-dot]'));
  let step = 0;
  const showStep = (next: number, shouldScroll = true) => { step = Math.max(0, Math.min(steps.length - 1, next)); steps.forEach((item,index) => item.hidden=index!==step); dots.forEach((dot,index) => dot.toggleAttribute('data-active',index<=step)); if(shouldScroll) window.scrollTo({top:Math.max(0,(form?.offsetTop??0)-120),behavior:'smooth'}); };
  const validateStep = () => Array.from(steps[step]?.querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>('input,select,textarea') ?? []).every((input) => input.reportValidity());
  document.querySelectorAll('[data-next]').forEach((button) => button.addEventListener('click',() => { if(validateStep()) showStep(step+1); }));
  document.querySelectorAll('[data-prev]').forEach((button) => button.addEventListener('click',() => showStep(step-1)));
  const methodInputs = document.querySelectorAll<HTMLInputElement>('input[name="preferred_service_method"]'); const address = document.querySelector<HTMLElement>('#address-fields');
  const syncAddress = () => { const method=document.querySelector<HTMLInputElement>('input[name="preferred_service_method"]:checked')?.value; const needed=method==='pickup'||method==='home-service'; if(address) address.hidden=!needed; address?.querySelectorAll<HTMLInputElement>('input').forEach((input) => input.required=needed && ['street','city'].includes(input.id)); };
  methodInputs.forEach((input) => input.addEventListener('change',syncAddress)); syncAddress();
  const query = new URLSearchParams(location.search); const service = query.get('service'); const select = document.querySelector<HTMLSelectElement>('#service_slug'); if(service&&select) select.value=service;
  showStep(0, false);
  form?.addEventListener('submit',async(event)=>{event.preventDefault();const status=document.querySelector<HTMLElement>('#form-status');const submit=form.querySelector<HTMLButtonElement>('button[type="submit"]');if(!form.reportValidity())return;if(submit)submit.disabled=true;if(status){status.dataset.state='';status.textContent='Mengirim booking…';status.style.display='block';}
    try{const response=await fetch(form.dataset.api??'',{method:'POST',headers:{Accept:'application/json'},body:new FormData(form)});const payload=await response.json();if(!response.ok){const errors=payload.errors?Object.values(payload.errors).flat().join(' '):payload.message;throw new Error(errors||'Booking belum dapat dikirim.');}const data=payload.data;sessionStorage.setItem('direpair_status_token',data.status_token);form.hidden=true;if(status){status.dataset.state='success';status.innerHTML=`<strong>Booking tercatat: ${data.request_number}</strong><br>${data.next_step}<br><a class="button dark status-link" href="${data.status_url}">Buka status privat</a>`;}}
    catch(error){if(status){status.dataset.state='error';status.textContent=error instanceof Error?error.message:'Booking belum dapat dikirim.';}}finally{if(submit)submit.disabled=false;}});
</script>
<style>
  .booking-hero{padding:78px 0 42px;border-bottom:2px solid var(--ink)}.booking-intro{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);align-items:end;gap:36px}.booking-intro h1{grid-column:1;margin:22px 0 0;max-width:780px;font-size:clamp(3.4rem,8vw,6rem);line-height:.88;letter-spacing:-.04em}.booking-intro .lede{grid-column:2;grid-row:1/3;margin:0 0 7px}.route-chip,.aside-code{font-family:var(--font-mono);font-size:.69rem;font-weight:760;letter-spacing:.13em}.route-chip{width:max-content;padding:7px 10px;border:1px solid var(--route-red);color:var(--route-red)}.form-section{padding-top:52px;background:color-mix(in srgb,var(--paper-deep) 62%,transparent)}.booking-grid{display:grid;grid-template-columns:minmax(230px,.68fr) minmax(0,1.32fr);gap:58px;align-items:start}.booking-grid aside{position:sticky;top:110px}.aside-code{display:block;color:var(--route-green)}.booking-grid aside h2{margin:12px 0 0;font-size:2rem}.booking-grid aside ol{list-style:none;padding:0;margin:28px 0}.booking-grid aside li{display:grid;grid-template-columns:42px 1fr;gap:14px;padding:16px 0;border-top:1px solid var(--ink);font-size:.89rem}.booking-grid aside li:last-child{border-bottom:1px solid var(--ink)}.booking-grid aside li span{font-family:var(--font-mono);font-size:.72rem;font-weight:800;color:var(--route-red)}.privacy-note{padding:18px;border:1px solid var(--ink);background:var(--ticket-yellow);box-shadow:0 12px 28px rgba(1,29,56,.13)}.privacy-note p{margin:6px 0 0;color:var(--ink);font-size:.82rem}.form-panel{border:2px solid var(--ink);background:color-mix(in srgb,var(--paper) 92%,white);padding:clamp(22px,4vw,42px);box-shadow:0 18px 42px rgba(1,29,56,.14)}.launch-block{margin-bottom:26px;padding:18px;border:1px solid var(--route-red);background:#ffdfcf;color:var(--ink)}.launch-block p{margin:5px 0 0}.step-indicator{display:grid;grid-template-columns:repeat(3,1fr);margin:-42px -42px 34px;border-bottom:2px solid var(--ink)}.step-indicator span{display:grid;grid-template-columns:auto 1fr;gap:8px;padding:16px 14px;border-right:1px solid var(--ink);color:var(--muted);font-size:.72rem;font-weight:800}.step-indicator span:last-child{border-right:0}.step-indicator b{font-family:var(--font-mono);color:var(--line)}.step-indicator span[data-active]{background:var(--route-navy);color:var(--paper)}.step-indicator span[data-active] b{color:var(--ticket-yellow)}fieldset{margin:0;padding:0;border:0}legend{margin-bottom:24px;font-size:clamp(1.65rem,3vw,2.2rem);font-weight:780;line-height:1}.nav-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:28px}.method-grid{display:grid;gap:0;margin-bottom:22px;border:1px solid var(--ink)}.method-grid label{position:relative;display:grid;grid-template-columns:28px 1fr;padding:17px;background:transparent;border-bottom:1px solid var(--ink);cursor:pointer}.method-grid label:last-child{border-bottom:0}.method-grid label:has(input:checked){background:color-mix(in srgb,var(--route-yellow) 42%,transparent)}.method-grid input{grid-row:1/3}.method-grid strong,.method-grid span{grid-column:2}.method-grid span{color:var(--muted);font-size:.82rem}.address-fields{padding:20px;margin-bottom:18px;border:1px dashed var(--route-blue);background:color-mix(in srgb,var(--paper) 68%,white)}.checks{display:grid;gap:13px;margin-top:20px}.checks label{display:flex;align-items:flex-start;gap:9px;font-size:.87rem}.checks input{margin-top:5px}.checks a{color:var(--route-red);text-decoration:underline}.honeypot{position:absolute;left:-10000px}.fine-print{padding:25px;border-top:4px solid var(--route-red)}.fine-print p{margin:7px 0 0;color:var(--muted)}:global(.status-link){margin-top:14px}@media(max-width:850px){.booking-intro{grid-template-columns:1fr}.booking-intro .lede{grid-column:1;grid-row:auto}.booking-grid{grid-template-columns:1fr}.booking-grid aside{position:static}.nav-actions{justify-content:stretch}.nav-actions .button{flex:1}}@media(max-width:540px){.booking-hero{padding-top:52px}.booking-intro h1{font-size:3.35rem}.form-panel{padding:22px 16px;box-shadow:0 12px 28px rgba(1,29,56,.12)}.step-indicator{margin:-22px -16px 28px}.step-indicator span{grid-template-columns:1fr;gap:3px;padding:12px 9px}.step-indicator b{font-size:.63rem}.nav-actions{flex-direction:column-reverse}}
</style>
