---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCmsDataset, isTrustedPublicContent, metaBoolean, metaString } from '../lib/cms';

const dataset = await getCmsDataset();
const cases = dataset.repairCases.filter((item)=>!import.meta.env.PROD || (isTrustedPublicContent(item) && metaBoolean(item,'publish_consent')));
---
<BaseLayout title="Repair Case · Direpair" description="Contoh kasus repair yang telah mendapat izin publikasi dan melewati verifikasi konten." noindex={cases.length===0}>
  <section class="page-hero"><div class="narrow"><span class="route-code">CASE LOG / VERIFIED</span><h1>Kasus yang boleh diceritakan.</h1><p class="lede">Production hanya menampilkan kasus nyata dengan izin publikasi. Identitas pelanggan dan catatan internal tidak pernah ditampilkan.</p></div></section>
  <section class="section"><div class="container case-grid">{cases.length ? cases.map((repairCase)=><article class="card">{repairCase.featured_image&&<img src={repairCase.featured_image.url} alt={repairCase.featured_image.alt || repairCase.title} width={repairCase.featured_image.width} height={repairCase.featured_image.height} />}<div class="copy"><span class="tag">{metaBoolean(repairCase,'is_demo')?'Fixture demo':'Kasus berizin'}</span><h2>{repairCase.title}</h2><p>{repairCase.excerpt}</p><dl><div><dt>Perangkat</dt><dd>{[metaString(repairCase,'device_brand'),metaString(repairCase,'device_model')].filter(Boolean).join(' ') || 'Tidak dipublikasikan'}</dd></div><div><dt>Gejala</dt><dd>{metaString(repairCase,'reported_symptom','Tidak dipublikasikan')}</dd></div><div><dt>Diagnosis</dt><dd>{metaString(repairCase,'diagnosis_summary','Tidak dipublikasikan')}</dd></div><div><dt>Tindakan</dt><dd>{metaString(repairCase,'repair_action','Tidak dipublikasikan')}</dd></div></dl></div></article>) : <div class="empty"><h2>Belum ada repair case publik.</h2><p>Bagian ini sengaja kosong sampai Direpair memiliki kasus nyata dan izin publikasi. Tidak ada cerita keberhasilan yang dibuat-buat.</p></div>}</div></section>
</BaseLayout>
<style>.page-hero{padding:78px 0;background:var(--warm)}.page-hero .lede{margin-top:22px}.case-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.case-grid article{overflow:hidden}.case-grid img{width:100%;aspect-ratio:16/9;object-fit:cover}.copy{padding:29px}.copy h2{margin:14px 0 10px;font-size:2rem}.copy>p{color:var(--muted)}dl{margin:20px 0 0}dl div{padding:12px 0;border-top:1px solid var(--line)}dt{color:var(--muted);font-size:.72rem;font-weight:800;text-transform:uppercase}dd{margin:4px 0 0}.empty{grid-column:1/-1;max-width:700px;padding:35px;border-top:2px solid var(--orange);background:var(--warm)}@media(max-width:760px){.case-grid{grid-template-columns:1fr}}</style>
