---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import DeviceArt from '../components/DeviceArt.astro';
import { getCmsDataset } from '../lib/cms';
const { settings } = await getCmsDataset();
---
<BaseLayout title="Cara Kerja Direpair" description="Alur diagnosis, quotation, persetujuan, repair, quality control, pembayaran, dan garansi Direpair.">
  <section class="about-hero"><div class="container hero-grid"><div><span class="route-code">PROCESS / DIREPAIR</span><h1>Repair bukan keputusan buta.</h1><p class="lede">Kami merancang proses agar masalah teknis, biaya, dan status pekerjaan terlihat sebelum kamu mengambil keputusan berikutnya.</p><div class="button-row"><a class="button" href={settings.booking_path}>Mulai cek kerusakan</a><a class="button secondary" href={settings.status_path}>Cek status</a></div></div><DeviceArt kind="tools" label="Ilustrasi proses diagnosis repair" /></div></section>
  <section class="section principles"><div class="container"><div class="section-heading"><div><span class="route-code">PROCESS / PRINCIPLES</span><h2>Transparansi dibuat menjadi sistem.</h2></div></div><div class="grid-3"><article class="card"><span>01</span><h3>Diagnosis sebelum janji hasil</h3><p>Konten publik menjelaskan kemungkinan, bukan mengklaim kepastian tanpa melihat unit.</p></article><article class="card"><span>02</span><h3>Quotation sebelum pekerjaan</h3><p>Jasa, komponen, discount, pajak, dan deposit ditampilkan sebagai item terpisah.</p></article><article class="card"><span>03</span><h3>Status yang bisa dilacak</h3><p>Pelanggan mendapat tautan privat untuk timeline, keputusan quotation, dan payment.</p></article></div></div></section>
  <section class="section flow"><div class="container"><span class="route-code">ROUTE / WARRANTY</span><ol><li><b>Booking</b><span>Perangkat, gejala, kontak, metode layanan, dan foto opsional dicatat.</span></li><li><b>Unit diterima</b><span>Tim mencatat penerimaan dan memulai pemeriksaan saat unit tersedia.</span></li><li><b>Diagnosis</b><span>Temuan dan repairability dibuat berversi agar perubahan tidak menghapus riwayat.</span></li><li><b>Approval</b><span>Pelanggan menyetujui atau menolak quotation dari tautan status privat.</span></li><li><b>Repair & QC</b><span>Pekerjaan berjalan setelah approval dan deposit bila memang diperlukan.</span></li><li><b>Pelunasan & serah terima</b><span>Sisa invoice dibuat setelah QC, lalu unit diserahkan setelah payment terverifikasi.</span></li><li><b>Garansi</b><span>Cakupan mengikuti pekerjaan dan komponen yang tertulis pada invoice.</span></li></ol></div></section>
</BaseLayout>
<style>.about-hero{padding:72px 0 85px}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center}.about-hero .lede{margin:24px 0 30px}.principles{background:var(--warm)}.principles article{padding:30px}.principles article>span{color:var(--route-red);font-family:var(--font-mono);font-weight:800}.principles h3{margin:55px 0 12px}.principles p{color:var(--muted)}.flow{background:var(--route-navy);color:var(--paper)}.flow .route-code{color:var(--ticket-yellow)}.flow ol{margin:40px 0 0;padding:0;list-style:none;border-top:1px solid #365b73}.flow li{display:grid;grid-template-columns:55px .55fr 1fr;gap:25px;padding:22px 0;border-bottom:1px solid #365b73;counter-increment:step}.flow li::before{content:counter(step,decimal-leading-zero);color:var(--ticket-yellow);font-family:var(--font-mono);font-size:.75rem}.flow li b{font-size:1.15rem}.flow li span{color:#b8c8d2}@media(max-width:800px){.hero-grid{grid-template-columns:1fr}.flow li{grid-template-columns:40px 1fr}.flow li span{grid-column:2}.grid-3{grid-template-columns:1fr}}</style>
