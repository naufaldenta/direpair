---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeviceArt from '../../components/DeviceArt.astro';
import PriceRange from '../../components/PriceRange.astro';
import FaqList from '../../components/FaqList.astro';
import { getCmsDataset, isTrustedPublicContent, metaNumber, metaString, metaStrings } from '../../lib/cms';
import { serviceIcon } from '../../lib/format';
import type { CmsContent } from '../../lib/cms-types';

export async function getStaticPaths() {
  const dataset = await getCmsDataset();
  return dataset.services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
interface Props { service: CmsContent; }
const { service } = Astro.props;
const dataset = await getCmsDataset();
const relatedProblems = dataset.problems.filter((problem) => Array.isArray(problem.meta.related_service_ids) && problem.meta.related_service_ids.includes(service.id));
const methods = metaStrings(service, 'service_methods');
const models = metaStrings(service, 'supported_models');
const from = metaNumber(service,'price_from'); const to = metaNumber(service,'price_to'); const diagnosis = metaNumber(service,'diagnosis_fee');
const minDays = metaNumber(service,'turnaround_min_days'); const maxDays = metaNumber(service,'turnaround_max_days');
const noindex = !isTrustedPublicContent(service) || service.meta.noindex === true || service.meta.noindex === '1';
const schema = isTrustedPublicContent(service) && !dataset.settings.demo_mode ? { '@context':'https://schema.org', '@type':'Service', name:service.title, description:service.excerpt, provider:{ '@type':'Organization', name:dataset.settings.business_name }, areaServed:'Indonesia', ...(from !== null ? { offers:{ '@type':'AggregateOffer', lowPrice:from, ...(to !== null ? { highPrice:to } : {}), priceCurrency:'IDR' } } : {}) } : null;
---
<BaseLayout title={`${metaString(service,'seo_title',service.title)} | Direpair`} description={metaString(service,'seo_description',service.excerpt)} noindex={noindex} image={service.featured_image?.url}>
  <section class="service-hero"><div class="container hero-grid"><div><span class="route-code">SERVICE / {service.slug}</span><h1>{metaString(service,'hero_title',service.title)}</h1><p class="lede">{metaString(service,'hero_summary',service.excerpt)}</p><div class="button-row"><a class="button" href={`/booking/?service=${service.slug}`}>Cek kerusakan</a><a class="button secondary" href="#harga">Lihat kisaran</a></div></div>{service.featured_image ? <img class="hero-image" src={service.featured_image.url} alt={service.featured_image.alt || service.title} width={service.featured_image.width} height={service.featured_image.height} /> : <DeviceArt kind={serviceIcon(service.slug)} label={`Ilustrasi ${service.title}`} />}</div></section>
  <section class="answer-strip"><div class="container"><span>Jawaban singkat</span><strong>{metaString(service,'quick_answer',service.excerpt)}</strong></div></section>
  <section id="harga" class="section"><div class="container content-grid"><div><span class="route-code">ESTIMATE / PRE-DIAGNOSIS</span><h2>Orientasi sebelum unit diperiksa.</h2><p class="lede">Kisaran ini bukan quotation. Kondisi unit dan komponen yang dibutuhkan hanya dapat dipastikan saat diagnosis.</p><PriceRange from={from} to={to} diagnosis={diagnosis} /><p class="small muted disclaimer">{metaString(service,'pricing_disclaimer',dataset.settings.default_pricing_disclaimer)}</p></div><div class="info-card card"><h3>Ekspektasi proses</h3><dl><div><dt>Estimasi waktu</dt><dd>{minDays !== null ? `${minDays}${maxDays !== null ? `–${maxDays}` : '+'} hari kerja` : 'Dikonfirmasi setelah diagnosis'}</dd></div><div><dt>Metode layanan</dt><dd>{methods.length ? methods.join(' · ') : 'Dikonfirmasi oleh tim'}</dd></div><div><dt>Garansi</dt><dd>{metaString(service,'warranty_summary','Mengikuti jenis pekerjaan dan komponen pada invoice.')}</dd></div></dl></div></div></section>
  {(models.length > 0 || service.content) && <section class="section detail-section"><div class="container detail-grid"><div class="prose" set:html={service.content}></div>{models.length > 0 && <aside class="card"><span class="route-code">MODEL / EXAMPLES</span><h3>Model yang pernah masuk kategori ini</h3><ul>{models.map((model) => <li>{model}</li>)}</ul><p class="small muted">Daftar bukan jaminan repairability. Model lain tetap dapat diajukan.</p></aside>}</div></section>}
  {relatedProblems.length > 0 && <section class="section"><div class="container"><div class="section-heading"><div><span class="route-code">PROBLEM / GUIDE</span><h2>Mulai dari gejala yang terlihat.</h2></div></div><div class="problem-grid">{relatedProblems.map((problem) => <a class="card" href={`/masalah/${problem.slug}/`}><span class="tag">Panduan awal</span><h3>{problem.title}</h3><p>{problem.excerpt}</p><strong>Baca panduan</strong></a>)}</div></div></section>}
  <section class="section faq-section"><div class="narrow"><div class="section-heading"><div><span class="route-code">FAQ / BEFORE BOOKING</span><h2>Pertanyaan yang sering muncul.</h2></div></div><FaqList items={dataset.faqs.slice(0,4)} /></div></section>
  <section class="section-sm"><div class="container final"><div><h2>Masih belum yakin?</h2><p>Kirim gejala dan foto. Booking tidak otomatis menyetujui repair atau pembayaran penuh.</p></div><a class="button" href={`/booking/?service=${service.slug}`}>Mulai cek kerusakan</a></div></section>
  {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
</BaseLayout>
<style>
  .service-hero{padding:72px 0}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center}.service-hero .lede{margin:24px 0 30px}.hero-image{width:100%;aspect-ratio:4/3;object-fit:cover;border:1px solid var(--line);border-radius:12px}.answer-strip{padding:21px 0;background:var(--teal);color:#fff}.answer-strip .container{display:grid;grid-template-columns:150px 1fr;gap:28px;align-items:center}.answer-strip span{font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;color:var(--lime);font-weight:800}.content-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:start}.content-grid .lede{margin:19px 0 26px}.disclaimer{margin-top:13px}.info-card{padding:30px}.info-card h3{margin-bottom:20px}.info-card dl{margin:0}.info-card dl div{padding:16px 0;border-top:1px solid var(--line)}dt{font-size:.72rem;color:var(--muted);text-transform:uppercase;font-weight:800;letter-spacing:.07em}dd{margin:3px 0 0;font-weight:750}.detail-section{background:var(--warm)}.detail-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:70px}.detail-grid aside{padding:28px}.detail-grid ul{padding-left:18px}.problem-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.problem-grid a{padding:25px}.problem-grid h3{margin:16px 0 9px}.problem-grid p{color:var(--muted)}.problem-grid strong{color:var(--orange-dark);font-size:.86rem}.faq-section{background:#fff}.final{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:40px;border:1px solid var(--line);border-radius:12px;background:var(--warm)}.final p{margin:8px 0 0;color:var(--muted)}@media(max-width:820px){.hero-grid,.content-grid,.detail-grid{grid-template-columns:1fr}.answer-strip .container{grid-template-columns:1fr;gap:5px}.problem-grid{grid-template-columns:1fr}.final{align-items:flex-start;flex-direction:column}}
</style>
