APP_NAME="Direpair Operations"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.direpair.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=direpair_direpair_api
DB_USERNAME=direpair_apiuser
DB_PASSWORD="__DIREPAIR_DB_PASSWORD__"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=api.direpair.id
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@direpair.id"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=__DIREPAIR_FRONTEND_ORIGIN__
PUBLIC_STATUS_URL=__DIREPAIR_FRONTEND_ORIGIN__/cek-status/
CORS_ALLOWED_ORIGINS=__DIREPAIR_FRONTEND_ORIGIN__
STATUS_TOKEN_PEPPER=__DIREPAIR_STATUS_TOKEN_PEPPER__
PRIVACY_POLICY_VERSION=production-2026-08-31

# Keep mock until a real Midtrans merchant sandbox has passed the complete
# payment/refund/reconciliation checklist. This prevents unverified transactions.
PAYMENT_DRIVER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com

DEMO_ADMIN_EMAIL=admin@direpair.id
DEMO_ADMIN_PASSWORD=

CMS_WEBHOOK_SECRET=
CMS_ALLOWED_ORIGIN=https://cms.direpair.id
